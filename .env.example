# Application Environment Configuration
PROJECT_NAME="CacheFlow AI - Automated Invoice Reconciliation"
DATABASE_URL="sqlite:///./cacheflow.db"
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=15

# Google Gemini API Key (Optional: system runs with offline deterministic reasoner if left blank)
GEMINI_API_KEY=""
GEMINI_MODEL_EXTRACTION="gemini-1.5-flash"
GEMINI_MODEL_ARBITRATION="gemini-1.5-pro"

# Financial Matching Tolerances
AMOUNT_TOLERANCE=1.0
TAX_TOLERANCE=1.0
PRICE_TOLERANCE=0.01
